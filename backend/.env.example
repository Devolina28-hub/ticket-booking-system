# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database (SQLite file path)
DB_PATH=./data/app.db

# Seat hold configuration
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
HOLD_SWEEPER_INTERVAL_SECONDS=30

# Email (SMTP). Leave blank to auto-use an Ethereal test account (free, logs preview URL to console instead of a real inbox).
# For REAL email delivery, use Brevo's free SMTP relay (300 emails/day free, no card required):
#   1. Sign up at https://www.brevo.com
#   2. Go to Settings -> SMTP & API -> SMTP tab
#   3. Copy the values below from that page
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login@smtp-brevo.com
# SMTP_PASS=your_brevo_smtp_key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Encore Tickets <no-reply@yourdomain.com>"

# Frontend URL (used in waitlist offer email links)
FRONTEND_URL=http://localhost:5173
