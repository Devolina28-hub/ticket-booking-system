# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database (Postgres via Neon -- free tier, persists across restarts/redeploys)
# Sign up free at https://neon.tech, create a project, and copy the connection
# string it gives you (Dashboard -> Connection Details -> "Connection string").
# It looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Seat hold configuration
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
HOLD_SWEEPER_INTERVAL_SECONDS=30

# Mock "Scan to Pay" payment step (NOT a real gateway -- see README section 7)
PAYMENT_QR_TTL_MINUTES=10

# Email (Brevo transactional API -- NOT SMTP). Leave BREVO_API_KEY blank and email
# sending is skipped entirely (with a warning logged); nothing falls back to a fake inbox.
# For real delivery via Brevo (no card required):
#   1. Sign up at https://www.brevo.com
#   2. Settings -> SMTP & API -> API Keys tab -> generate a key -> paste it below
#   3. Settings -> Senders, Domains & Dedicated IPs -> Senders -> add + verify the
#      address you put in SMTP_FROM below (Brevo won't send from an unverified sender)
#   4. Settings -> Security -> Authorized IPs -> activate/authorize the key(s) so
#      requests from your deployed backend aren't blocked
BREVO_API_KEY=
SMTP_FROM="Encore Tickets <no-reply@yourdomain.com>"

# Frontend URL (used in waitlist offer email links)
FRONTEND_URL=http://localhost:5173
