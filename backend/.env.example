# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database (Postgres via Neon -- free tier, persists across restarts/redeploys)
# Sign up free at https://neon.tech, create a project, and copy the connection
# string it gives you (Dashboard -> Connection Details -> "Connection string").
# It looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Seat hold configuration
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
HOLD_SWEEPER_INTERVAL_SECONDS=30
MAX_SEATS_PER_BOOKING=5

# Mock "Scan to Pay" payment step (NOT a real gateway -- see README section 7)
PAYMENT_QR_TTL_MINUTES=10

# Email (Resend transactional API -- NOT SMTP). Leave RESEND_API_KEY blank and email
# sending is skipped entirely (with a warning logged); nothing falls back to a fake inbox.
# For real delivery via Resend (no card required):
#   1. Sign up at https://resend.com
#   2. Dashboard -> API Keys -> Create API Key -> permission "Sending access" -> paste it below
#   3. Dashboard -> Domains -> Add Domain -> add the SPF/DKIM/DMARC records it gives you at
#      your DNS provider, then wait for it to show "Verified" (usually a few minutes)
#   4. Set SMTP_FROM to an address on that verified domain
# Until step 3 is done, SMTP_FROM falls back to Resend's onboarding@resend.dev sandbox
# sender, which Resend will ONLY deliver to the email address you signed up to Resend
# with -- not to real customers. Fine for testing, not for production bookings.
RESEND_API_KEY=
SMTP_FROM="Encore Tickets <no-reply@yourdomain.com>"

# Frontend URL (used in waitlist offer email links)
FRONTEND_URL=http://localhost:5173
