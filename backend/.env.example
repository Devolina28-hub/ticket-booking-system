# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database (SQLite file path)
DB_PATH=./data/app.db

# Seat hold configuration
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
HOLD_SWEEPER_INTERVAL_SECONDS=30

# Email (SMTP). Leave blank to auto-use an Ethereal test account (free, logs preview URL to console).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ticket Booking <no-reply@ticketbooking.local>"

# Frontend URL (used in waitlist offer email links)
FRONTEND_URL=http://localhost:5173
