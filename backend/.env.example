# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database (Postgres via Neon -- free tier, persists across restarts/redeploys)
# Sign up free at https://neon.tech, create a project, and copy the connection
# string it gives you (Dashboard -> Connection Details -> "Connection string").
# It looks like: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Seat hold configuration
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=15
HOLD_SWEEPER_INTERVAL_SECONDS=30
MAX_SEATS_PER_BOOKING=5

# Mock "Scan to Pay" payment step (NOT a real gateway -- see README section 7)
PAYMENT_QR_TTL_MINUTES=10

# Email (EmailJS -- sends through a real connected Gmail account, not SMTP, not a
# transactional provider). Leave any of these blank and email sending is skipped
# entirely (with a warning logged); nothing falls back to a fake inbox.
#
# Unlike Resend/Brevo, EmailJS needs NO domain verification -- it authenticates as the
# actual Gmail you connect via OAuth, so it can email any real recipient from day one.
# Trade-off: free tier caps at 200 emails/month, and does not support real file
# attachments (fine here -- the QR code is sent as an inline base64 image instead).
#
# Setup (no card required):
#   1. Sign up at https://emailjs.com
#   2. Email Services -> Add New Service -> Gmail -> Connect Account (OAuth popup,
#      sign in with the Gmail you want to send from) -> this gives you EMAILJS_SERVICE_ID
#   3. Email Templates -> Create New Template -> Subject: {{subject}}, To Email:
#      {{to_email}}, Content (switch to code/HTML editor): just {{message_html}} and
#      nothing else -> Save -> this gives you EMAILJS_TEMPLATE_ID
#   4. Account -> Security -> turn ON "Allow API calls from non-browser applications"
#      (easy to miss -- without it every request from this backend gets a 403)
#   5. Account -> API Keys -> EMAILJS_PUBLIC_KEY. Account -> Security -> EMAILJS_PRIVATE_KEY
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Frontend URL (used in waitlist offer email links)
FRONTEND_URL=http://localhost:5173
